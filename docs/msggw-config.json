{
  "state_dir": "/var/lib/msggw",
  "root_dir": "/data/msggw",
  "backend": {
    "driver": "postgres",
    "sqlite": {
      "path": "vault:containers/msggw#msggw_sqllite_datapath"
    },
    "postgres": {
      "dsn_ref": "vault:containers/msggw#msggw_pgsql_dsn"
    }
  },

  "log": {
    "level": "info",
    "format": "json"
  },

  "vault": {
    "address": "env:VAULT_ADDR",
    "token_ref": "env:VAULT_TOKEN"
  },

  "mattermost": {
    "url": "vault:containers/msggw#mmost_server_url",
    "token_ref": "vault:containers/msggw#mmost_messagegateway_bot_token",
    "insecure_skip_verify": false,
    "reconnect_backoff_seconds": 5,
    "request_timeout_seconds": 30
  },

  "users": [
    {
      "name": "jfgratton",
      "gmessages": {
        "ping_interval_seconds": 60,
        "force_rcs": true,
        "mark_read_on_bridge": false,
        "backfill_count": 0
      },
      "routing": {
        "default": {
          "type": "channel",
          "team": "famille",
          "channel": "rcs-mms-sms"
        },
        "rules": [
          {
            "name": "FAMILLE: vicky desrosiers, liliane gratton, philippe gratton, yoko wakyama",
            "phones": ["+15149690948", "+14385180577", "+14388217445", "+14388809656"],
            "destination": {
              "type": "direct",
              "user": "vault:containers/msggw#mmost_user"
            }
          },
          {
            "name": "group chats get their own channel",
            "groups_only": true,
            "destination": {
              "type": "channel",
              "team": "vault:containers/msggw#mmost_team",
              "channel": "messages-de-groupes"
            }
          }
        ],
        "thread_per_conversation": true,
        "post_delivery_status": true,
        "join_channels": true
      }
    }
  ]
}
