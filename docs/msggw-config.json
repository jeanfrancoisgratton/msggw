{
  "state_dir": "/var/lib/msggw",
  "root_dir": "/data",
  "backend": {
    "driver": "postgres",
    "sqlite": {
      "path": "sqlite3/msggw.db"
    },
    "postgres": {
      "dsn_ref": "vault:containers/msggw#msggw_pgsql_dsn"
    }
  },

  "log": {
    "level": "info",
    "format": "text"
  },

  "vault": {
    "_comment": "the 'env:' URI scheme can be replaced with the 'literal:' scheme",
    "address": "env:VAULT_ADDR",
    "token_ref": "env:VAULT_MSGGW_RO"
  },

  "mattermost": {
    "url": "vault:containers/msggw#mmost_server_url",
    "token_ref": "vault:containers/msggw#mmost_messagegateway_bot_token",
    "insecure_skip_verify": false,
    "reconnect_backoff_seconds": 5,
    "request_timeout_seconds": 30
  },


  "listener": {
    "port": 1106,
    "cert_file": "/etc/msggw/tls/msggw.famillegratton.net.crt",
    "key_file": "/etc/msggw/tls/msggw.famillegratton.net.key"
  },

  "users": [
    {
      "name": "jfgratton",
      "gmessages": {
        "ping_interval_seconds": 60,
        "force_rcs": true,
        "mark_read_on_bridge": false,
        "backfill_count": 0
      },
      "routing": {
        "default_direct": {
          "type": "channel",
          "team": "MessageGateway",
          "channel": "messages"
        },
        "default_group": {
          "type": "channel",
          "team": "MessageGateway",
          "channel": "group-messages"
        },
        "rules": [
          {
            "name": "Famille: vik, lili, phil, yoko",
            "phones": ["+15149690948", "+14385180577", "+14388217445", "+14388809656"],
            "destination": {
              "type": "direct",
              "user": "jfgratton"
            }
          }
        ],
        "thread_per_conversation": true,
        "post_delivery_status": true,
        "join_channels": true
      }
    }
  ]
}
