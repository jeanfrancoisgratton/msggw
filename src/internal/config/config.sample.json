{
  "state_dir": "/var/lib/msggw",
  "root_dir": "/data",
  "backend": {
    "driver": "sqlite",
    "sqlite": {
      "path": "msggw.db"
    },
    "postgres": {
      "dsn_ref": "vault:secrets/msggw#database_dsn"
    }
  },

  "log": {
    "level": "info",
    "format": "text"
  },

  "vault": {
    "address": "https://vault.example.net:8200",
    "token_ref": "env:VAULT_TOKEN"
  },

  "mattermost": {
    "url": "https://mattermost.example.net",
    "token_ref": "file:/etc/msggw/mattermost.token",
    "insecure_skip_verify": false,
    "reconnect_backoff_seconds": 5,
    "request_timeout_seconds": 30
  },

  "listener": {
    "port": 0,
    "cert_file": "/etc/msggw/tls/listener.crt",
    "key_file": "/etc/msggw/tls/listener.key"
  },

  "users": [
    {
      "name": "jfgratton",
      "gmessages": {
        "ping_interval_seconds": 60,
        "force_rcs": true,
        "mark_read_on_bridge": false,
        "backfill_count": 0
      },
      "remote_pairing": {
        "token_ref": "vault:secrets/msggw#jfgratton_pairing_token"
      },
      "routing": {
        "default": {
          "type": "channel",
          "team": "myteam",
          "channel": "messages"
        },
        "rules": [
          {
            "name": "family goes to my DMs",
            "phones": ["+1 514 555-1212", "+15145551213"],
            "destination": {
              "type": "direct",
              "user": "jfgratton"
            }
          },
          {
            "name": "group chats get their own channel",
            "groups_only": true,
            "destination": {
              "type": "channel",
              "team": "myteam",
              "channel": "group-messages"
            }
          }
        ],
        "thread_per_conversation": true,
        "post_delivery_status": true,
        "join_channels": true
      }
    },
    {
      "name": "kiddo",
      "gmessages": {
        "force_rcs": true
      },
      "routing": {
        "default": {
          "type": "direct",
          "user": "kiddo"
        },
        "thread_per_conversation": true,
        "post_delivery_status": true,
        "join_channels": true
      }
    }
  ]
}
